default_platform(:android)

platform :android do
  
  # Build lanes
  desc "Build debug APK"
  lane :build_debug do
    gradle(task: "clean assembleDebug")
  end

  desc "Build release APK"
  lane :build_release do
    gradle(task: "clean assembleRelease")
  end

  desc "Build release bundle (AAB)"
  lane :build_bundle do
    gradle(task: "clean bundleRelease")
  end

  # Testing lanes
  desc "Run unit tests"
  lane :test do
    gradle(task: "test")
  end

  # Code quality lanes
  desc "Run ktlint"
  lane :lint_kotlin do
    gradle(task: "ktlintCheck")
  end

  desc "Run ktlint and auto-format"
  lane :format_kotlin do
    gradle(task: "ktlintFormat")
  end

  desc "Run detekt"
  lane :analyze do
    gradle(task: "detekt")
  end

  desc "Run all code quality checks"
  lane :quality do
    gradle(task: "ktlintCheck")
    gradle(task: "detekt")
    gradle(task: ":app:lintDevDebug")
  end

  desc "Generate debug unit test coverage reports"
  lane :coverage do
    gradle(task: ":app:testDevDebugUnitTest :app:createDevDebugUnitTestCoverageReport")
  end

  desc "Validate release packaging and baseline profile setup"
  lane :release_readiness do
    gradle(task: ":app:assembleRelease :app:bundleRelease")
    gradle(task: ":baselineprofile:verifyBaselineProfileSetup")
  end

  desc "Build a release candidate with quality and readiness checks"
  lane :release_candidate do
    gradle(task: "clean")
    gradle(task: "ktlintCheck detekt testDebugUnitTest :app:testDevDebugUnitTest")
    gradle(task: ":app:verifyDebugCoverage")
    release_readiness
  end

  desc "Release packaging automation entry point"
  lane :release_automation do
    release_candidate
    gradle(task: ":app:assembleProdRelease :app:bundleProdRelease")
  end

  # CI/CD lane
  desc "Run CI checks"
  lane :ci do
    gradle(task: "clean")
    gradle(task: "ktlintCheck")
    gradle(task: "detekt")
    gradle(task: "test")
    gradle(task: ":app:lintDevDebug")
    gradle(task: ":app:createDevDebugUnitTestCoverageReport")
    gradle(task: ":app:assembleRelease")
  end

end
