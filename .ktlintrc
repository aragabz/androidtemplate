# Ktlint configuration
# https://pinterest.github.io/ktlint/latest/rules/configuration-ktlint/

# Disabled rules
disabled_rules=
  # Allow wildcard imports for testing and common packages
  no-wildcard-imports,
  # Allow longer function names for Compose @Composable functions
  function-naming

# Import layout
ij_kotlin_imports_layout=*,java.**,javax.**,kotlin.**,^

# Max line length (matches .editorconfig)
max_line_length=120

# Trailing commas
ij_kotlin_allow_trailing_comma=true
ij_kotlin_allow_trailing_comma_on_call_site=true

# Experimental rules (opt-in)
ktlint_experimental=enabled

# Compose-specific rules
ktlint_function_naming_ignore_when_annotated_with=Composable,Preview

# Code style
ktlint_code_style=android_studio
